{
  "expo": {
    "name": "Eu Vejo Você",
    "slug": "eu-vejo-voce",
    "version": "1.0.0",
    "orientation": "portrait",
    "splash": {
      "backgroundColor": "#1a1a2e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.lcsmj.meuappmobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Este app precisa de sua localização para registrar coordenadas GPS precisas."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7f99051b-8dff-4c2b-a91d-dccd18a15907"
      }
    }
  }
}
