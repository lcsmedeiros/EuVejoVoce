{
  "expo": {
    "name": "Eu Vejo Você",
    "slug": "eu-vejo-voce",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0B0F0C",
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F0C"
      },
      "package": "com.lcsmj.meuappmobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Este app precisa de sua localização para registrar coordenadas GPS precisas."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F0C"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "7f99051b-8dff-4c2b-a91d-dccd18a15907"
      }
    }
  }
}
